rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per room: games/{roomCode}. Clients are the game authority (no server), so these rules
    // can only bound the damage: signed-in users only, sane shape/size, host-only delete.
    // Enable Authentication → Sign-in method → Anonymous in the Firebase console BEFORE deploying.
    match /games/{room} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && room.size() >= 4 && room.size() <= 12
        && request.resource.data.gameState is map
        && request.resource.data.gameState.players.size() <= 8
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.gameState is map
        && request.resource.data.gameState.players.size() <= 8
        && request.resource.data.gameState.properties.size() == 40
        && request.resource.data.get('hostUid', null) == resource.data.get('hostUid', null);
      allow delete: if request.auth != null
        && (resource.data.get('hostUid', null) == null || resource.data.hostUid == request.auth.uid);
    }
  }
}
